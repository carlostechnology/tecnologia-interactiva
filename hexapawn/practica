  </section>`;

  document.getElementById("errors").onclick=()=>showResults(false);
  document.getElementById("all").onclick=()=>showResults(true);
  document.getElementById("homeButton").onclick=home;

  document.getElementById("downloadJSON").onclick=()=>{
    download("Hexapawn_resultado.json",JSON.stringify({
      activity:"SmartChess · Hexapawn · TIC II",
      name:session.name,group:session.group,
      date:new Date(session.ended).toISOString(),
      result:r,answers:session.answers
    },null,2),"application/json");
  };

  document.getElementById("downloadHTML").onclick=()=>{
    const html=`<!DOCTYPE html><html lang="es"><meta charset="UTF-8">
    <title>Resultado Hexapawn TIC II</title>
    <style>body{font:15px/1.6 Arial;max-width:850px;margin:35px auto;padding:20px;color:#273d33}
