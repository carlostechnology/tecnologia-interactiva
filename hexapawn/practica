  document.getElementById("startForm").onsubmit=e=>{
    e.preventDefault();
    if(saved&&!confirm("¿Sustituir el progreso guardado por una actividad nueva?"))return;
    const f=new FormData(e.target);
    session={
      name:String(f.get("name")).trim(),
      group:String(f.get("group")).trim(),
      mode:f.get("mode"),
      started:Date.now(),
      ended:null,
      answers:[],
      current:null,
      level:2,
      streak:0,
      feedback:false,
      done:false
    };
    save();render();
  };
}

function answered(id){
  return session.answers.some(a=>a.id===id);
}

function topicStats(topic){
  const arr=session.answers.filter(a=>questions[a.id].topic===topic);
  return {
    count:arr.length,
    correct:arr.filter(a=>a.ok).length,
    accuracy:arr.length?arr.filter(a=>a.ok).length/arr.length:0
  };
}

function shouldFinish(){
  if(session.mode==="practice")return session.answers.length===60;
  const n=session.answers.length;
  if(n<30)return false;
  if(n>=45)return true;
  if(n%6!==0)return false;
  const covered=BANK.every((_,i)=>topicStats(i).count>=5);
  const solid=BANK.every((_,i)=>topicStats(i).accuracy>=.6);
  return covered&&solid;
}

function nextQuestion(){
  if(session.current)return session.current;
  const available=questions.filter(q=>!answered(q.id));
  if(!available.length)return null;

  let pool=available;

  if(session.mode==="practice"){
    pool.sort((a,b)=>a.id-b.id);
  }else{
    const ranked=BANK.map((_,i)=>({
      topic:i,
      ...topicStats(i)
    })).filter(x=>available.some(q=>q.topic===x.topic));

    ranked.sort((a,b)=>{
      if(session.answers.length<30)return a.count-b.count||a.topic-b.topic;
      return a.accuracy-b.accuracy||a.count-b.count;
    });

    pool=available.filter(q=>q.topic===ranked[0].topic);
    pool.sort((a,b)=>
      Math.abs(a.difficulty-session.level)-Math.abs(b.difficulty-session.level)
      ||Math.random()-.5
    );
  }

  const q=pool[0];
  session.current={id:q.id,order:shuffle([0,1,2,3])};
  save();
  return session.current;
}

function answer(choice){
  if(!session.current||session.done)return;
  const q=questions[session.current.id];
  const ok=choice===0;
  session.answers.push({
    id:q.id,choice,ok,at:Date.now()
  });
  session.current=null;
  session.streak=ok?Math.max(1,session.streak+1):Math.min(-1,session.streak-1);
  if(session.streak>=2){session.level=Math.min(5,session.level+1);session.streak=0;}
  if(session.streak<=-2){session.level=Math.max(1,session.level-1);session.streak=0;}
  if(shouldFinish()){
    session.done=true;
    session.ended=Date.now();
  }
  session.feedback=session.mode==="practice";
  save();render();
}

function render(){
  if(!session){home();return;}
  if(session.feedback){showFeedback();return;}
  if(session.done){showResults();return;}
  const current=nextQuestion();
  if(!current){
    session.done=true;
    session.ended=Date.now();
    save();showResults();return;
  }
  const q=questions[current.id],n=session.answers.length;
  const total=session.mode==="practice"?60:45;
  app.innerHTML=`
  <section class="card">
    <div class="row">
      <span class="eyebrow">${session.mode==="practice"?"PRÁCTICA COMPLETA":"EXAMEN ADAPTATIVO"} · PREGUNTA ${n+1}</span>
      <span class="small">${esc(session.name)}</span>
    </div>
    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="${total}" aria-valuenow="${n}">
      <i style="width:${n/total*100}%"></i>
    </div>
    <p class="small">Bloque ${q.topic+1} · ${esc(BANK[q.topic].name)} · Nivel ${q.difficulty}/5</p>
    <div class="question">${format(q.text)}</div>
    <form id="answerForm">
      <div class="answers">
        ${current.order.map((original,i)=>`
        <label class="answer">
          <input type="radio" name="choice" value="${original}" required>
          <span class="letter">${"ABCD"[i]}</span>
          <span>${format(q.options[original])}</span>
        </label>`).join("")}
      </div>
      <button class="primary" type="submit">Confirmar respuesta →</button>
    </form>
    <p class="small">La respuesta confirmada no se puede cambiar.</p>
  </section>`;
  document.getElementById("answerForm").onsubmit=e=>{
    e.preventDefault();
    const selected=app.querySelector("input[name=choice]:checked");
    if(selected)answer(Number(selected.value));
  };
}

function showFeedback(){
  const a=session.answers.at(-1),q=questions[a.id];
  app.innerHTML=`
  <section class="card">
    <span class="eyebrow">PRÁCTICA · ${session.answers.length} DE 60</span>
    <h2>${a.ok?"¡Respuesta correcta!":"Vamos a repasarlo"}</h2>
    <p>${format(q.text)}</p>
    <div class="feedback ${a.ok?"correct":"incorrect"}">
      <strong>Tu respuesta:</strong> ${format(q.options[a.choice])}
      ${a.ok?"":`<p><strong>Respuesta correcta:</strong> ${format(q.options[0])}</p>`}
    </div>
    <p>${esc(q.explanation)}</p>
    <p class="small">Bloque: ${esc(BANK[q.topic].name)}</p>
    <button class="primary" id="continue">${session.done?"Ver resultado final":"Siguiente pregunta"} →</button>
  </section>`;
  document.getElementById("continue").onclick=()=>{
    session.feedback=false;save();render();
  };
}

function report(){
  const n=session.answers.length;
  const weights=[1,1.35,1.7,2.15,2.65];
  let possible=0,earned=0;
  session.answers.forEach(a=>{
    const w=weights[questions[a.id].difficulty-1];
    possible+=w;if(a.ok)earned+=w;
  });
  const correct=session.answers.filter(a=>a.ok).length;
  return {
    n,correct,
    percentage:n?Math.round(correct/n*100):0,
    score:possible?Math.round(100*earned/possible)/10:0,
    seconds:Math.round(((session.ended||Date.now())-session.started)/1000)
  };
}

function reviewHTML(all){
  const arr=session.answers.filter(a=>all||!a.ok);
  if(!arr.length)return "<p>No hay errores que revisar. ¡Enhorabuena!</p>";
  return arr.map(a=>{
    const q=questions[a.id];
    return `<article class="review">
      <span class="small">${esc(BANK[q.topic].name)} · ${a.ok?"✓ Correcta":"✗ Incorrecta"}</span>
      <h3>${format(q.text)}</h3>
      <p>Tu respuesta: ${format(q.options[a.choice])}</p>
      <p><strong>Respuesta correcta: ${format(q.options[0])}</strong></p>
      <p>${esc(q.explanation)}</p>
    </article>`;
  }).join("");
}

