    @media print{article{break-inside:avoid}}</style>
    <h1>SmartChess · Hexapawn · TIC II</h1>
    <p><b>Alumno:</b> ${esc(session.name)}<br><b>Grupo:</b> ${esc(session.group)}
    <br><b>Fecha:</b> ${esc(new Date(session.ended).toLocaleString("es-ES"))}
    <br><b>Modalidad:</b> ${session.mode==="practice"?"Práctica":"Examen adaptativo"}</p>
    <h2>Nota: ${r.score.toFixed(1)}/10</h2>
    <p>Aciertos: ${r.correct}/${r.n} (${r.percentage}%)</p>
    <h2>Respuestas y explicaciones</h2>${reviewHTML(true)}
