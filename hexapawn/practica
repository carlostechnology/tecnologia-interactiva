function mountBoard(){
  let board,turn,selected,winner;
  const grid=document.getElementById("board");
  const other=p=>p==="B"?"N":"B";

  function legalMoves(r,c){
    if(board[r][c]!==turn)return [];
    const nr=r+(turn==="B"?-1:1);
    if(nr<0||nr>2)return [];
    const result=[];
    if(board[nr][c]===".")result.push([nr,c]);
    for(const dc of [-1,1]){
      const nc=c+dc;
      if(nc>=0&&nc<3&&board[nr][nc]===other(turn)){
        result.push([nr,nc]);
      }
    }
    return result;
  }

  function hasMoves(){
    return board.some((row,r)=>row.some((p,c)=>
      p===turn&&legalMoves(r,c).length>0
    ));
  }

  function redraw(){
    grid.replaceChildren();
    const possible=selected?legalMoves(...selected):[];
    for(let r=0;r<3;r++){
      for(let c=0;c<3;c++){
        const piece=board[r][c];
        const btn=document.createElement("button");
        btn.type="button";
        btn.className="square "+((r+c)%2?"dark":"light");
        if(selected&&selected[0]===r&&selected[1]===c)btn.classList.add("selected");
        if(possible.some(m=>m[0]===r&&m[1]===c))btn.classList.add("legal");
        const coord="abc"[c]+(3-r);
        btn.setAttribute("aria-label",coord+": "+(piece==="B"?"blanca":piece==="N"?"negra":"vacía"));
        const mark=document.createElement("span");
        mark.className="coord";mark.textContent=coord;btn.append(mark);
        if(piece!=="."){
          const pawn=document.createElement("span");
          pawn.className="pawn "+(piece==="B"?"white":"black");
          pawn.textContent="♟";btn.append(pawn);
        }
        btn.onclick=()=>select(r,c);
        grid.append(btn);
      }
    }
    document.getElementById("turnText").textContent=winner
      ?"Ganan las "+(winner==="B"?"blancas":"negras")+" 🎉"
      :"Turno de "+(turn==="B"?"blancas":"negras");
  }

  function select(r,c){
    if(winner)return;
    if(selected&&legalMoves(...selected).some(m=>m[0]===r&&m[1]===c)){
      const [sr,sc]=selected,played=turn;
      board[sr][sc]=".";
      board[r][c]=played;
      selected=null;
      turn=other(played);
      if((played==="B"&&r===0)||(played==="N"&&r===2)||
         !board.flat().includes(turn)||!hasMoves())winner=played;
      document.getElementById("gameMessage").textContent=winner
        ?"¡Partida terminada!":"Movimiento "+("abc"[sc])+(3-sr)+"-"+("abc"[c])+(3-r)+".";
    }else{
      selected=board[r][c]===turn?[r,c]:null;
      document.getElementById("gameMessage").textContent=selected
        ?"Elige uno de los destinos señalados."
        :"Selecciona un peón del color que mueve.";
    }
    redraw();
  }

  function reset(){
    board=[["N","N","N"],[".",".","."],["B","B","B"]];
    turn="B";selected=null;winner=null;
    document.getElementById("gameMessage").textContent="Avanza recto a una casilla vacía o captura en diagonal.";
    redraw();
  }

  document.getElementById("resetBoard").onclick=reset;
  reset();
}

function home(){
  const saved=getSaved();
  app.innerHTML=`
  <section class="card">
    <span class="eyebrow">TECNOLOGÍAS DE LA INFORMACIÓN Y LA COMUNICACIÓN II</span>
    <h1>Aprende a programar con Hexapawn.</h1>
    <p>Comprueba cuánto sabes de las reglas del juego, las listas, los bucles, las funciones y los movimientos en Python.</p>
    <div class="notice"><strong>60 preguntas · 6 bloques.</strong> Funciona sin Internet, sin cuentas y sin instalar programas.</div>
    ${saved?`<div class="notice">Hay una actividad guardada: ${saved.answers.length} respuestas.</div>
      <button class="secondary" id="resume">Continuar o ver el resultado anterior</button>`:""}
    <form id="startForm">
      <label>Nombre o alias
        <input type="text" name="name" maxlength="100" required placeholder="Nombre del alumno">
