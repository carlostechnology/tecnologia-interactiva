        </label>
      </div>
      <button type="submit" class="primary">Empezar actividad →</button>
    </form>
    <p class="small">Tu progreso se guarda en este navegador cuando está permitido. Puedes descargar los resultados al terminar. No se envían automáticamente al profesor.</p>
    <details><summary>Los seis bloques</summary>
      ${BANK.map((b,i)=>`<p><strong>${i+1}. ${esc(b.name)}</strong> · ${esc(b.summary)}</p>`).join("")}
